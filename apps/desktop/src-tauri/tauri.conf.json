{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Krevo",
  "version": "0.4.3",
  "identifier": "app.krevo.studio",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "Krevo — crie tudo em um só lugar",
        "width": 1440,
        "height": 920,
        "minWidth": 1040,
        "minHeight": 680,
        "resizable": true,
        "fullscreen": false,
        "center": true,
        "decorations": true,
        "transparent": false,
        "dragDropEnabled": true,
        "theme": "Dark"
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": [
          "**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.ico",
      "icons/icon.icns"
    ],
    "copyright": "© 2026 Krevo · MIT",
    "category": "GraphicsAndDesign",
    "shortDescription": "Estúdio de design com agente de IA",
    "longDescription": "Krevo é o estúdio de design nativo que edita PDF, apresentações, imagens, vídeo e muito mais — com um agente de IA ao lado e a sua própria chave de API. Motor de PDF vetorial em Rust, sem Chromium.",
    "publisher": "Krevo",
    "homepage": "https://github.com/Pedro21062014/krevo",
    "createUpdaterArtifacts": false,
    "macOS": {
      "entitlements": "entitlements.plist",
      "minimumSystemVersion": "10.15"
    },
    "linux": {
      "deb": {
        "depends": [
          "gstreamer1.0-plugins-base",
          "gstreamer1.0-plugins-good",
          "gstreamer1.0-plugins-bad",
          "gstreamer1.0-libav",
          "gstreamer1.0-pulseaudio",
          "gstreamer1.0-alsa"
        ]
      },
      "appimage": {
        "bundleMediaFramework": true
      }
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "PortugueseBR",
          "English"
        ]
      }
    }
  }
}
